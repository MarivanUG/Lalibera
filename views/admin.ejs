<!doctype html><html lang="en"><head><%- include('partials/head',{title:'Admin',description:'Lalibera administration'}) %></head><body><div class="admin-wrap"><div class="container"><div class="admin-panel"><div class="eyebrow">Private administration</div><h2>Website content</h2><p class="lead">Update key homepage, pricing and contact details.</p><form id="adminForm" class="admin-grid"><div class="form-group full"><label>Hero title</label><input name="hero.title" value="<%= content.hero.title %>"></div><div class="form-group full"><label>Hero subtitle</label><textarea name="hero.subtitle"><%= content.hero.subtitle %></textarea></div><div class="form-group"><label>Deluxe single</label><input type="number" name="pricing.deluxe_single" value="<%= content.pricing.deluxe_single %>"></div><div class="form-group"><label>Deluxe double</label><input type="number" name="pricing.deluxe_double" value="<%= content.pricing.deluxe_double %>"></div><div class="form-group"><label>Standard single</label><input type="number" name="pricing.standard_single" value="<%= content.pricing.standard_single %>"></div><div class="form-group"><label>Standard double</label><input type="number" name="pricing.standard_double" value="<%= content.pricing.standard_double %>"></div><div class="form-group full"><label>Address</label><input name="contact.address" value="<%= content.contact.address %>"></div><div class="form-group"><label>Primary phone</label><input name="contact.phone.0" value="<%= content.contact.phone[0] %>"></div><div class="form-group"><label>Email</label><input name="contact.email" value="<%= content.contact.email %>"></div><div class="full"><button class="btn btn-primary" type="submit">Save changes</button><a href="/" class="btn" style="margin-left:8px">View site</a><div id="status" class="status"></div></div></form></div></div></div><script>function setDeep(o,p,v){var k=p.split('.'),c=o;for(var i=0;i<k.length-1;i++){var n=k[i],next=k[i+1];if(!(n in c))c[n]=/^\d+$/.test(next)?[]:{};c=c[n]}c[k[k.length-1]]=v}document.getElementById('adminForm').addEventListener('submit',async function(e){e.preventDefault();var s=document.getElementById('status');s.textContent='Saving…';try{var r=await fetch('/api/content');var data=await r.json();new FormData(e.target).forEach(function(v,k){if(k.indexOf('pricing.')===0)v=Number(v);setDeep(data,k,v)});var x=await fetch('/api/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});s.textContent=x.ok?'Saved successfully.':'Save failed.'}catch(err){s.textContent='Save failed.'}});</script></body></html>
