<!doctype html><html lang="en"><head><%- include('partials/head',{title:'Rooms',description:'Comfortable deluxe and standard rooms at Lalibera Classic Motel.'}) %></head><body><%- include('partials/header',{page}) %><section class="page-hero"><img src="/images/Home3-1.jpg" alt="Lalibera room"><div class="container"><div class="eyebrow">Sleep well</div><h1>Rooms made for rest.</h1></div></section><section class="section"><div class="container"><div class="cards"><article class="card"><div class="card-media"><img src="/images/Deluxe1-920x650.jpg" alt="Deluxe room"></div><div class="card-body"><h3>Deluxe Room</h3><p>Extra space and comfort for couples and business travellers.</p><div class="feature-list"><div class="feature"><b>Single</b><span><%= content.pricing.deluxe_single.toLocaleString() %> <%= content.pricing.currency %></span></div><div class="feature"><b>Double</b><span><%= content.pricing.deluxe_double.toLocaleString() %> <%= content.pricing.currency %></span></div></div><a href="/contact" class="btn btn-primary">Book deluxe</a></div></article><article class="card"><div class="card-media"><img src="/images/Standard1-920x650.jpg" alt="Standard room"></div><div class="card-body"><h3>Standard Room</h3><p>Clean, cosy and practical with essential guest amenities.</p><div class="feature-list"><div class="feature"><b>Single</b><span><%= content.pricing.standard_single.toLocaleString() %> <%= content.pricing.currency %></span></div><div class="feature"><b>Double</b><span><%= content.pricing.standard_double.toLocaleString() %> <%= content.pricing.currency %></span></div></div><a href="/contact" class="btn btn-primary">Book standard</a></div></article><article class="card"><div class="card-media"><img src="/images/NET-920x650.jpg" alt="Room amenity"></div><div class="card-body"><h3>Included comforts</h3><p>Wi-Fi, en-suite bathrooms, TV and attentive service help make every stay easy.</p><a href="/services" class="price">See services →</a></div></article></div></div></section><%- include('partials/footer') %></body></html>
