<!doctype html><html lang="en"><head><%- include('partials/head',{title:'Contact & Booking',description:'Contact Lalibera Classic Motel or send a booking inquiry.'}) %></head><body><%- include('partials/header',{page}) %><section class="page-hero"><img src="/images/Front-1.jpg" alt="Lalibera Classic Motel entrance"><div class="container"><div class="eyebrow">We’re ready when you are</div><h1>Plan your stay.</h1></div></section><section class="section"><div class="container contact-grid"><aside class="contact-card"><div class="eyebrow">Contact details</div><h2>Reach us directly.</h2><div class="feature-list"><div class="feature"><b>Visit</b><span><%= content.contact.address %></span></div><div class="feature"><b>Call</b><span><%= content.contact.phone.join(' / ') %></span></div><div class="feature"><b>Email</b><span><%= content.contact.email %></span></div><div class="feature"><b>Hours</b><span><%= content.contact.working_hours %></span></div></div></aside><div class="form-card"><h3>Booking / inquiry</h3><form id="bookingForm" class="form-grid"><div class="form-group"><label>Name</label><input name="name" required></div><div class="form-group"><label>Email</label><input type="email" name="email" required></div><div class="form-group"><label>Phone</label><input name="phone"></div><div class="form-group"><label>Subject</label><input name="subject" value="Booking inquiry"></div><div class="form-group full"><label>Message</label><textarea name="message" required placeholder="Tell us your preferred dates, room type and number of guests."></textarea></div><div class="full"><button class="btn btn-primary" type="submit">Send inquiry</button><div class="notice" id="formStatus"></div></div></form></div></div></section><script>document.getElementById('bookingForm').addEventListener('submit',async function(e){e.preventDefault();var s=document.getElementById('formStatus');s.textContent='Sending…';try{var r=await fetch('/api/book',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});var d=await r.json();s.textContent=d.message||d.error||'Request completed.';if(r.ok)e.target.reset()}catch(err){s.textContent='Unable to send right now. Please call us directly.'}});</script><%- include('partials/footer') %></body></html>
