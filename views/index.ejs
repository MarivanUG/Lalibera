<!doctype html><html lang="en"><head><%- include('partials/head',{title:'Home',description:content.meta.description}) %></head><body><%- include('partials/header',{page}) %>
<section class="hero"><img class="hero-bg" src="/images/Front-1.jpg" alt="Lalibera Classic Motel"><div class="container hero-content"><div class="eyebrow"><%= content.hero.eyebrow %></div><h1><%= content.hero.title %></h1><p><%= content.hero.subtitle %></p><div class="hero-actions"><a href="/contact" class="btn btn-primary"><%= content.hero.cta_text %></a><a href="/rooms" class="btn btn-outline">Explore rooms</a></div></div></section>
<section class="section"><div class="container intro-grid"><div class="image-frame"><img src="/images/Home3-1.jpg" alt="Comfortable room at Lalibera"></div><div><div class="eyebrow">A better stopover</div><h2>Easy comfort, thoughtfully done.</h2><p class="lead">Whether you are travelling for business, visiting family or simply taking a break, Lalibera offers a peaceful base with practical comforts and attentive service.</p><div class="stats"><div class="stat"><strong>24/7</strong>Open to guests</div><div class="stat"><strong>Wi-Fi</strong>Stay connected</div><div class="stat"><strong>Mukono</strong>Convenient location</div></div></div></div></section>
<section class="section band"><div class="container"><div class="eyebrow">Stay your way</div><h2>Rooms for restful nights.</h2><p class="lead">Choose between our deluxe and standard rooms, with rates designed for both solo travellers and couples.</p><div class="cards" style="margin-top:34px"><article class="card"><div class="card-media"><img src="/images/Deluxe1-920x650.jpg" alt="Deluxe room"></div><div class="card-body"><h3>Deluxe Room</h3><p>Spacious comfort with a polished feel for business or leisure.</p><div class="price">From <%= content.pricing.deluxe_single.toLocaleString() %> <%= content.pricing.currency %></div></div></article><article class="card"><div class="card-media"><img src="/images/Standard1-920x650.jpg" alt="Standard room"></div><div class="card-body"><h3>Standard Room</h3><p>A comfortable, practical stay with the essentials done well.</p><div class="price">From <%= content.pricing.standard_single.toLocaleString() %> <%= content.pricing.currency %></div></div></article><article class="card"><div class="card-media"><img src="/images/Restaurant_49.jpg" alt="Restaurant"></div><div class="card-body"><h3>Dining</h3><p>Fresh meals, breakfast and relaxed dining during your stay.</p><a href="/menu" class="price">Discover dining →</a></div></article></div></div></section>
<section class="section"><div class="container"><div class="eyebrow">A glimpse inside</div><h2>Simple spaces, warm atmosphere.</h2><div class="gallery" style="margin-top:34px"><img src="/images/Home1.jpg" alt="Lalibera grounds"><img src="/images/Home2.jpg" alt="Lalibera interior"><img src="/images/Restaurant1.jpg" alt="Restaurant"><img src="/images/Home5.jpg" alt="Motel exterior"><img src="/images/Home6.jpg" alt="Guest area"></div></div></section>
<section class="section" style="background:var(--cream)"><div class="container"><div class="eyebrow">Guest impressions</div><h2>Warm service leaves a mark.</h2><div class="reviews" style="margin-top:30px"><% content.reviews.forEach(function(r){ %><blockquote class="review"><div class="stars"><%= '★★★★★'.slice(0,r.rating) %></div><p>“<%= r.text %>”</p><strong><%= r.name %></strong></blockquote><% }) %></div></div></section>
<%- include('partials/footer') %></body></html>
